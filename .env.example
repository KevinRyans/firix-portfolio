# --- Kontaktskjema (Resend) ---
# Nøkkel fra resend.com. Domenet firix.no må være verifisert der.
RESEND_API_KEY=

# --- Admin (/admin) ---
# Passordet for å logge inn og styre prosjektene.
# Merk: IKKE bruk prefikset VITE_ på denne. Alt som starter med VITE_ blir
# kompilert inn i den offentlige JavaScript-bundlen og kan leses av hvem som helst.
ADMIN_PASSWORD=

# Valgfritt. Nøkkelen som signerer admin-sesjonstokenet.
# Settes den ikke, brukes ADMIN_PASSWORD. Setter du den, må du generere en
# lang tilfeldig streng — og alle innloggede sesjoner logges ut når den endres.
ADMIN_SESSION_SECRET=

# --- Vercel KV / Upstash Redis ---
# Lagrer prosjektlisten og besøksstatistikk. Legges inn automatisk når du
# kobler en KV-database til prosjektet i Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Reserveløsning for kontaktskjemaet (kun GitHub Pages) ---
# Brukes automatisk når /api/contact ikke finnes, altså så lenge siden ligger
# på GitHub Pages. Legges inn som repo-secret med samme navn.
# Denne SKAL ha VITE_-prefiks: Web3Forms-nøkler er ment å være offentlige.
# Kan fjernes etter flyttingen til Vercel.
VITE_WEB3FORMS_KEY=
